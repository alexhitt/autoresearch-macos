{
  "tfidf": {
    "max_features": 1800,
    "min_df": 2,
    "max_df": 0.75,
    "ngram_range": [
      1,
      3
    ],
    "sublinear_tf": true
  },
  "features": {
    "use_source_id": true,
    "use_source_kind": true,
    "use_url_domain": true,
    "use_summary_length": true,
    "use_mission_count": true
  },
  "model": {
    "type": "logistic_regression",
    "C": 0.8,
    "class_weight": "balanced"
  },
  "label": {
    "treat_soft_as": "positive",
    "gold_weight": 9.0
  }
}